"""
Uso:
  professore-digitale              avvia (o riapre) l'applicazione nel browser
  professore-digitale --stop       chiude il server locale
  professore-digitale --status     mostra lo stato dei componenti
  professore-digitale --no-browser avvia solo il server e stampa l'indirizzo
  professore-digitale --version
Variabili utili: PD_BROWSER (comando browser), PD_PORT, OLLAMA_HOST
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request

APP_ID = "professore-digitale"
SHARE = os.environ.get("PD_SHARE_DIR", "/usr/share/professore-digitale")
SERVER = os.path.join(SHARE, "server", "pd_server.py")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
RUNTIME_FILE = os.path.join(RUNTIME_DIR, "%s-%d.json" % (APP_ID, os.getuid()))


def notify_error(msg):
    sys.stderr.write("Professore Digitale: %s\n" % msg)
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
        for cmd in (["zenity", "--error", "--title=Professore Digitale", "--text=" + msg],
                    ["kdialog", "--error", msg, "--title", "Professore Digitale"],
                    ["notify-send", "Professore Digitale", msg]):
            if shutil.which(cmd[0]):
                subprocess.call(cmd, stderr=subprocess.DEVNULL)
                break


def running_port():
    try:
        with open(RUNTIME_FILE) as f:
            info = json.load(f)
        port = int(info["port"])
        with urllib.request.urlopen("http://127.0.0.1:%d/api/status" % port, timeout=4) as r:
            if json.loads(r.read().decode("utf-8")).get("ok"):
                return port
    except Exception:
        pass
    return None


def start_server():
    log_dir = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), APP_ID)
    try:
        os.makedirs(log_dir, exist_ok=True)
        log = open(os.path.join(log_dir, "server.log"), "ab")
    except OSError:
        log = subprocess.DEVNULL
    subprocess.Popen([sys.executable, "-B", SERVER], stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                     start_new_session=True, close_fds=True)
    deadline = time.time() + 45  # i PC molto vecchi possono essere lenti
    while time.time() < deadline:
        time.sleep(0.4)
        port = running_port()
        if port:
            return port
    return None


def open_browser(url):
    custom = os.environ.get("PD_BROWSER")
    if custom:
        return subprocess.Popen([custom, url], start_new_session=True)
    # 1) browser Chromium-like in "modalita' applicazione" (finestra pulita, senza barre)
    for b in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable",
              "brave-browser", "microsoft-edge", "vivaldi"):
        exe = shutil.which(b)
        if exe:
            return subprocess.Popen([exe, "--app=" + url, "--no-first-run",
                                     "--autoplay-policy=no-user-gesture-required"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    start_new_session=True)
    # 2) Firefox in nuova finestra
    for b in ("firefox-esr", "firefox", "librewolf"):
        exe = shutil.which(b)
        if exe:
            return subprocess.Popen([exe, "--new-window", url], stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True)
    # 3) browser predefinito del sistema
    for b in ("xdg-open", "x-www-browser"):
        exe = shutil.which(b)
        if exe:
            return subprocess.Popen([exe, url], stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True)
    return None


def main():
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0
    if "--version" in args:
        print("Professore Digitale 2.0.0")
        return 0
    port = running_port()
    if "--stop" in args:
        if port:
            req = urllib.request.Request("http://127.0.0.1:%d/api/shutdown" % port, data=b"{}",
                                         headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=5).read()
            print("Server fermato.")
        else:
            print("Il server non era in esecuzione.")
        return 0
    if not port:
        if not os.path.isfile(SERVER):
            notify_error("Installazione danneggiata: manca %s. Reinstallare il pacchetto." % SERVER)
            return 1
        port = start_server()
        if not port:
            notify_error("Il server locale non si e' avviato. Controllare ~/.local/state/professore-digitale/server.log")
            return 1
    url = "http://127.0.0.1:%d/" % port
    if "--status" in args:
        with urllib.request.urlopen(url + "api/status", timeout=10) as r:
            print(json.dumps(json.loads(r.read().decode("utf-8")), indent=2, ensure_ascii=False))
        return 0
    if "--no-browser" in args:
        print(url)
        return 0
    if open_browser(url) is None:
        notify_error("Nessun browser trovato. Aprire manualmente l'indirizzo: " + url)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
